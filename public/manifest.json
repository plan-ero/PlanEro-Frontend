{
  "name": "Planero - Event Planning Platform",
  "short_name": "Planero",
  "description": "Discover unique venues, vendors, and services for your special event. From dreamy weddings to epic parties - find spaces designed to impress.",
  "start_url": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "theme_color": "#2563eb",
  "background_color": "#ffffff",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["lifestyle", "business", "social", "shopping"],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+planero",
      "url": "/share?url=%s"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "images",
          "accept": ["image/*"]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/placeholder-logo.png",
      "sizes": "72x72",
      "type": "image/png"
    },
    {
      "src": "/placeholder-logo.png",
      "sizes": "96x96",
      "type": "image/png"
    },
    {
      "src": "/placeholder-logo.png",
      "sizes": "128x128",
      "type": "image/png"
    },
    {
      "src": "/placeholder-logo.png",
      "sizes": "144x144",
      "type": "image/png"
    },
    {
      "src": "/placeholder-logo.png",
      "sizes": "152x152",
      "type": "image/png"
    },
    {
      "src": "/placeholder-logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/placeholder-logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/placeholder-logo.png",
      "sizes": "384x384",
      "type": "image/png"
    },
    {
      "src": "/placeholder-logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/placeholder-logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Planero venue discovery interface"
    },
    {
      "src": "/screenshot-narrow.png",
      "sizes": "640x1136",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Mobile venue browsing experience"
    }
  ],
  "shortcuts": [
    {
      "name": "Search Venues",
      "short_name": "Venues",
      "description": "Find the perfect venue for your event",
      "url": "/venues",
      "icons": [
        {
          "src": "/placeholder-logo.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Browse Services",
      "short_name": "Services",
      "description": "Discover amazing services for your event",
      "url": "/services",
      "icons": [
        {
          "src": "/placeholder-logo.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Find Vendors",
      "short_name": "Vendors",
      "description": "Connect with professional vendors",
      "url": "/vendors",
      "icons": [
        {
          "src": "/placeholder-logo.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "My Favorites",
      "short_name": "Favorites",
      "description": "View your saved venues and services",
      "url": "/favorites",
      "icons": [
        {
          "src": "/placeholder-logo.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ]
}
